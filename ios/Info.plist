<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only the keys added to (or changed in) the Info.plist xtool generates -->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Manhunt</string>

    <!-- Shown in iOS's own permission prompts -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Manhunt shares your position with the players in your lobby, including while the phone is locked.</string>
    <key>NSCameraUsageDescription</key>
    <string>Manhunt uses the camera to scan a lobby's invite code, and for a profile photo if you take one.</string>

    <!-- Staying in a lobby with the phone locked: iOS lets an app that is
         following the player's location keep running (LocationBridge.swift) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>

    <!-- Always dark, like the web app, the launch screen included -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
    <key>UILaunchScreen</key>
    <dict/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
