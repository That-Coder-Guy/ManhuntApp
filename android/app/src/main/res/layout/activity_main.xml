<?xml version="1.0" encoding="utf-8"?>
<!-- The web app, full screen, with the app's few own screens over it:
     loading, choosing the server, and "can't reach the server" -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The web view is made in code, one per server -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/text_secondary"
        android:visibility="gone" />

    <!-- Can't reach the server -->
    <ScrollView
        android:id="@+id/problem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink_page"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/problem_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/problem_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/problem_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_tertiary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/problem_retry"
                style="@style/Manhunt.Button.Primary"
                android:layout_marginTop="24dp"
                android:text="@string/problem_retry" />

            <Button
                android:id="@+id/problem_change_server"
                style="@style/Manhunt.Button.Secondary"
                android:layout_marginTop="12dp"
                android:text="@string/problem_change_server" />
        </LinearLayout>
    </ScrollView>

    <!-- Choosing the game server -->
    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink_page"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/setup_title"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_intro"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <EditText
                android:id="@+id/setup_address"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/field_background"
                android:hint="@string/setup_address_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/setup_problem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/negative"
                android:textSize="15sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/setup_connect"
                    style="@style/Manhunt.Button.Primary"
                    android:text="@string/setup_connect" />

                <ProgressBar
                    android:id="@+id/setup_checking"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:elevation="4dp"
                    android:indeterminateTint="@color/on_accent"
                    android:visibility="gone" />
            </FrameLayout>

            <Button
                android:id="@+id/setup_cancel"
                style="@style/Manhunt.Button.Plain"
                android:layout_marginTop="12dp"
                android:text="@string/setup_cancel"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
