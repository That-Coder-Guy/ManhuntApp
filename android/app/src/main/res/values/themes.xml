<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, like the web app -->
    <style name="Theme.Manhunt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Manhunt.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Manhunt.Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Manhunt.Button.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Manhunt.Button.Plain">
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
