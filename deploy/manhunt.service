# Runs the Manhunt server (frontend + API + Socket.IO) on boot.
# Install on the Pi (edit User / paths first if yours differ):
#   sudo cp deploy/manhunt.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now manhunt
# Logs: journalctl -u manhunt -f

[Unit]
Description=Manhunt game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ManhuntApp
ExecStart=/usr/bin/node server/server.js
Environment=NODE_ENV=production
Environment=PORT=3001
Restart=always
RestartSec=3
# Basic hardening: the server only needs to read the app and open a port
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
